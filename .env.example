# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# excluded from the Docker build context — never commit it, never paste it into
# chat or screenshots. In production set these as real environment variables on
# the host platform instead of shipping a file.

# --- Razorpay -------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Test keys start with `rzp_test_`, live
# keys with `rzp_live_`. The key id is public (it reaches the browser); the
# secret never leaves the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks. This is the secret you type in when
# creating the webhook, NOT the API key secret. Leave blank and the webhook
# endpoint refuses every request rather than trusting unsigned payloads.
RAZORPAY_WEBHOOK_SECRET=

# GST added on top of the listed plan prices, as a percentage. The pricing
# cards quote amounts excluding GST; this is what gets added at checkout.
GST_PERCENT=18

# --- MSG91 (sign-in OTP) --------------------------------------------------
# Panel -> Settings -> API keys. Leave blank in local dev: the app then prints
# each OTP to the console instead of sending it, so the flow is testable
# without spending an SMS or waiting on DLT approval.
MSG91_AUTH_KEY=

# Sign-in and sign-up use two SEPARATE DLT-approved templates, so two ids. Both
# are the MSG91 template id (a hex string), not the template name.
#
# Sign-in — login_ledger_v1.0.json. Variables: `otp`, `valifity` (sic; that
# misspelling is what was registered on DLT, so the code sends it verbatim).
MSG91_OTP_TEMPLATE_ID=

# Sign-up — ledgerit_login_v1.0.json. Variables: `otp`, `validity`.
MSG91_REGISTER_TEMPLATE_ID=

# Registered DLT header / sender id, e.g. LDGRIT. Optional — leave blank to use
# whichever sender the template is already bound to.
MSG91_SENDER_ID=

# --- Flask ----------------------------------------------------------------
# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 in production so the session cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=0

# --- MongoDB --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ledgerit
